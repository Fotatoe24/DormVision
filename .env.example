# Copy this file to .env.local and fill it in. .env.local is git-ignored; this
# example file is the one that is committed, so NEVER put real values in it.

# ---- Supabase (server-side only) -------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Full database access, bypassing row-level security. Server only: never expose
# it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sign-in sessions ------------------------------------------------------
# Signs the session cookie. Use a long random value, e.g. `openssl rand -base64 32`.
# There is deliberately no default: the app refuses to start without it.
# Changing it signs everyone out.
JWT_SECRET=

# ---- Email (Gmail SMTP) ----------------------------------------------------
# Password-reset links and event notifications (new requests, payments...).
# GMAIL_APP_PASSWORD is a Google "App password", not your normal password.
# If these are empty, emails are skipped and the rest of the app still works.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Optional --------------------------------------------------------------
# The public address of the site, used for links inside emails
# (https://dorm-vision.vercel.app). If unset, the address of the request is used.
# Note: if you set this in .env.local, emails sent while testing locally link to
# that address, not to localhost.
NEXT_PUBLIC_SITE_URL=
